-- ===== inf jump =====
local lastJump = 0
UserInputService.JumpRequest:Connect(function()
	if not ready or not state.infJump then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and os.clock() - lastJump >= JUMP_COOLDOWN then
		lastJump = os.clock()
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- ===== aimbot: sticky hard head lock + prediction =====
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local locked = nil

local function aimPartOf(hum)
	local model = hum.Parent
	return model and (model:FindFirstChild(AIM_PART) or model:FindFirstChild("HumanoidRootPart"))
end

local function validTarget(hum, myRoot, center)
	local model = hum.Parent
	if not model or not model.Parent then return nil end
	local part = aimPartOf(hum)
	if not part or hum.Health <= 0 or isTeammate(model) then return nil end
	if (part.Position - myRoot.Position).Magnitude > MAX_DISTANCE then return nil end

	local sp = camera:WorldToViewportPoint(part.Position)
	if sp.Z <= 0 then return nil end
	local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
	if d > AIM_FOV then return nil end

	if not state.wallAim then
		local origin = camera.CFrame.Position
		local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
		if hit and not hit.Instance:IsDescendantOf(model) then return nil end
	end
	return part, d
end

local function aimStep()
	if not ready or not state.aimbot then locked = nil return end
	camera = Workspace.CurrentCamera
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	rayParams.FilterDescendantsInstances = { myChar }
	local vp = camera.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)

	local part
	if locked then part = validTarget(locked, myRoot, center) end

	if not part then
		locked = nil
		local bestD = math.huge
		for _, hum in ipairs(targets) do
			local p, d = validTarget(hum, myRoot, center)
			if p and d < bestD then
				bestD, part, locked = d, p, hum
			end
		end
	end

	if part then
		local aimPos = part.Position + part.AssemblyLinearVelocity * PREDICTION
		local pos = camera.CFrame.Position
		local goal = CFrame.new(pos, aimPos)
		camera.CFrame = AIM_SMOOTH >= 1 and goal or camera.CFrame:Lerp(goal, AIM_SMOOTH)
	end
end

-- after default camera script so it doesn't fight us
RunService:BindToRenderStep("AmerAim", Enum.RenderPriority.Camera.Value + 1, function()
	local ok, err = pcall(aimStep)
	if not ok then warn("[Amer aim]", err) end
end)
RunService:BindToRenderStep("AmerESP", Enum.RenderPriority.Camera.Value + 2, function()
	local ok, err = pcall(espStep)
	if not ok then warn("[Amer esp]", err) end
end)

-- ===== background loop =====
task.spawn(function()
	while true do
		local ok, err = pcall(function()
			if state.aimbot or state.esp then refreshTargets() end
			if ready and state.esp then syncESP() end
		end)
		if not ok then warn("[Amer loop]", err) end
		task.wait(0.5)
	end
end)

