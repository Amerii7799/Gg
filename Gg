local function makeToggle(label, y, key, onChange)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -16, 0, 34)
	btn.Position = UDim2.new(0, 8, 0, y)
	btn.BackgroundColor3 = state[key] and ON_COLOR or OFF_COLOR
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.Text = label .. ": " .. (state[key] and "ON" or "OFF")
	btn.Parent = menu
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	btn.Activated:Connect(function()
		state[key] = not state[key]
		btn.Text = label .. ": " .. (state[key] and "ON" or "OFF")
		btn.BackgroundColor3 = state[key] and ON_COLOR or OFF_COLOR
		if onChange then onChange(state[key]) end
	end)
end

-- ===== targets cache =====
local targets = {}
local function refreshTargets()
	local list = {}
	if INCLUDE_NPCS then
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("Humanoid") and d.Parent and d.Parent ~= player.Character then
				table.insert(list, d)
			end
		end
	else
		for _, p in ipairs(Players:GetPlayers()) do
			local h = p ~= player and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if h then table.insert(list, h) end
		end
	end
	targets = list
end

local function isTeammate(model)
	local plr = Players:GetPlayerFromCharacter(model)
	return TEAM_CHECK and plr ~= nil and plr.Team ~= nil and plr.Team == player.Team
end

-- ===== ESP: 2D screen boxes (works on any client) + optional Highlight =====
local espObjs = {} -- [model] = { frame, stroke, label, hum, hl }

local function clearESP(model)
	local o = espObjs[model]
	if not o then return end
	if o.frame then o.frame:Destroy() end
	if o.hl then o.hl:Destroy() end
	espObjs[model] = nil
end

local function clearAllESP()
	for model in pairs(espObjs) do clearESP(model) end
end

local function addESP(hum)
	local model = hum.Parent
	if not model or espObjs[model] then return end

	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = espGui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = ENEMY_COLOR
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 0, -2)
	label.Size = UDim2.fromOffset(180, 32)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = ENEMY_COLOR
	label.TextStrokeTransparency = 0.4
	label.Parent = frame

	-- Highlight is optional: old mobile Studio may not support it
	local hl
	pcall(function()
		hl = Instance.new("Highlight")
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.6
		hl.OutlineTransparency = 0
		hl.FillColor = ENEMY_COLOR
		hl.Parent = model
	end)

	espObjs[model] = { frame = frame, stroke = stroke, label = label, hum = hum, hl = hl }
end

local function syncESP()
	for _, hum in ipairs(targets) do
		local model = hum.Parent
		if model and hum.Health > 0 and not espObjs[model] and model:FindFirstChild("HumanoidRootPart") then
			addESP(hum)
		end
	end
end

local function espStep()
	if not ready or not state.esp then return end
	camera = Workspace.CurrentCamera
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	for model, o in pairs(espObjs) do
		local root = model.Parent and model:FindFirstChild("HumanoidRootPart")
		if not root or o.hum.Health <= 0 then
			clearESP(model)
		else
			local dist = (root.Position - myRoot.Position).Magnitude
			local top = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3.2, 0))
			local bot = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.4, 0))
			if dist > MAX_DISTANCE or top.Z <= 0 or bot.Z <= 0 then
				o.frame.Visible = false
			else
				local h = math.max(math.abs(bot.Y - top.Y), 8)
				local w = h * 0.55
				o.frame.Size = UDim2.fromOffset(w, h)
				o.frame.Position = UDim2.fromOffset(top.X - w / 2, top.Y)
				local col = isTeammate(model) and TEAM_COLOR or ENEMY_COLOR
				o.stroke.Color = col
				o.label.TextColor3 = col
				if o.hl then o.hl.FillColor = col end
				o.label.Text = string.format("%s\n%d HP | %dm", model.Name, math.floor(o.hum.Health), math.floor(dist))
				o.frame.Visible = true
			end
		end
	end
end

