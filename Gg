-- جا: StarterPlayer > StarterPlayerScripts  و  RunContext = Client

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- ===== settings =====
local JUMP_COOLDOWN = 0.1
local AIM_PART      = "Head"
local AIM_FOV       = 500      -- px radius from screen center
local AIM_SMOOTH    = 1        -- 1 = instant hard lock, lower = softer
local PREDICTION    = 0.08     -- seconds of velocity lead (0 = off)
local MAX_DISTANCE  = 2000     -- studs
local TEAM_CHECK    = true
local INCLUDE_NPCS  = true

local ENEMY_COLOR = Color3.fromRGB(255, 60, 60)
local TEAM_COLOR  = Color3.fromRGB(60, 255, 120)
local ON_COLOR    = Color3.fromRGB(46, 160, 67)
local OFF_COLOR   = Color3.fromRGB(170, 50, 50)

-- ===== state =====
local state = { infJump = false, aimbot = false, esp = false, wallAim = true }
local ready = false

